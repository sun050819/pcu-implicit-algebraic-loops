# normalize line endings (LF) for consistent cross-platform and GitHub display
* text=auto

*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.m text eol=lf
*.txt text eol=lf

*.png binary
*.docx binary
*.pkl binary
*.slx binary
